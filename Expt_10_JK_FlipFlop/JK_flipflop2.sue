proc SCHEMATIC_JK_flipflop2 {} {
make NAND_3input -name xi0 -origin {1540 -70}
make NAND_3input -name xi1 -origin {1540 270}
make output -name Qn -origin {2290 -80}
make output -name Qn_1 -origin {2280 240}
make inout -name vdd -origin {2160 410}
make inout -name gnd -origin {1940 450}
make input -name J -origin {1180 -80}
make input -name K -origin {1190 300}
make input -name clk -origin {1320 90}
make nand_1_sue -name xi2 -origin {1950 -70}
make nand_1_sue -name xi3 -origin {1960 250}
  make_wire 1850 -80 1640 -80
  make_wire 1850 -60 1800 -60
  make_wire 1800 150 2160 150
  make_wire 2160 240 2060 240
  make_wire 2160 240 2280 240
  make_wire 1800 170 2140 170
  make_wire 2140 -80 2050 -80
  make_wire 2140 -80 2290 -80
  make_wire 1640 -40 1700 -40
  make_wire 2050 -40 2170 -40
  make_wire 2120 -20 2050 -20
  make_wire 2060 300 2120 300
  make_wire 1860 240 1800 240
  make_wire 2160 390 2170 390
  make_wire 1940 420 2120 420
  make_wire 2160 150 2160 240
  make_wire 1440 -60 1400 -60
  make_wire 1400 90 1320 90
  make_wire 1400 280 1440 280
  make_wire 1440 -40 1420 -40
  make_wire 1420 20 1800 20
  make_wire 1440 260 1420 260
  make_wire 1420 190 1800 190
  make_wire 1800 190 1800 240
  make_wire 1800 190 1800 170
  make_wire 1420 190 1420 260
  make_wire 1190 300 1440 300
  make_wire 1860 260 1640 260
  make_wire 1420 -40 1420 20
  make_wire 1180 -80 1440 -80
  make_wire 2140 -80 2140 170
  make_wire 2120 -20 2120 300
  make_wire 2120 300 2120 420
  make_wire 1800 -60 1800 20
  make_wire 1800 20 1800 150
  make_wire 1400 -60 1400 90
  make_wire 1400 90 1400 280
  make_wire 1700 -40 1700 300
  make_wire 2160 390 2160 410
  make_wire 1700 300 1700 420
  make_wire 1700 420 1940 420
  make_wire 1700 300 1640 300
  make_wire 1940 420 1940 450
  make_wire 1640 -20 1670 -20
  make_wire 1670 390 2160 390
  make_wire 1640 320 1670 320
  make_wire 1670 320 1670 -20
  make_wire 1670 320 1670 390
  make_wire 2060 280 2170 280
  make_wire 2170 280 2170 390
  make_wire 2170 280 2170 -40
}

proc ICON_JK_flipflop2 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -20} -name J
icon_term -type input -origin {-100 0} -name K
icon_term -type input -origin {-100 20} -name clk
icon_term -type output -origin {100 -20} -name Qn
icon_term -type output -origin {100 0} -name Qn_1
icon_term -type inout -origin {100 40} -name vdd
icon_term -type inout -origin {100 60} -name gnd
icon_property -origin {-90 -20} -label J
icon_property -origin {-90 0} -label K
icon_property -origin {-90 20} -label clk
icon_property -origin {90 -20} -anchor e -label Qn
icon_property -origin {90 0} -anchor e -label Qn_1
icon_property -origin {90 40} -anchor e -label vdd
icon_property -origin {90 60} -anchor e -label gnd
icon_property -origin {-90 -70} -label {$name}
icon_property -origin {-90 -50} -label JK_flipflop2
  icon_line -100 -60 100 -60 100 80 -100 80 -100 -60
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0
}

