proc SCHEMATIC_JK_flipfloptest2 {} {
make global -name vdd -origin {1200 250}
make global -name gnd -origin {960 310}
make output -name Qn -origin {1160 100}
make output -name Qn_1 -origin {1160 120}
make input -name clk -origin {550 140}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {760 210}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {800 20}
make pulse -name V2 -pulse_voltage 1.3V -pulse_width 6ns -period 12ns -origin {590 210}
make JK_flipflop2 -name xi0 -origin {950 120}
make input -name J -origin {710 100}
make input -name K -origin {710 120}
  make_wire 650 -50 650 280
  make_wire 1130 180 1130 280
  make_wire 1050 100 1160 100
  make_wire 800 -50 800 -20
  make_wire 760 250 760 280
  make_wire 960 280 960 310
  make_wire 590 250 590 280
  make_wire 650 -50 800 -50
  make_wire 800 100 710 100
  make_wire 800 100 850 100
  make_wire 760 170 760 120
  make_wire 760 120 850 120
  make_wire 760 120 710 120
  make_wire 1050 120 1160 120
  make_wire 760 280 960 280
  make_wire 960 280 1130 280
  make_wire 1130 180 1050 180
  make_wire 1050 160 1200 160
  make_wire 1200 160 1200 250
  make_wire 590 140 590 170
  make_wire 590 280 650 280
  make_wire 650 280 760 280
  make_wire 550 140 590 140
  make_wire 850 140 590 140
  make_wire 800 60 800 100
}

