proc SCHEMATIC_nor_2_test {} {
make nor_2 -name xi0 -origin {10 80}
make input -name A -origin {-300 70}
make input -name B -origin {-310 90}
make output -name vout -origin {290 70}
make global -name vdd -origin {290 140}
make global -name gnd -origin {-40 370}
make pulse -orient RY -name A_pulse -pulse_voltage 1.3V -origin {-200 -10}
make pulse -name B_pulse -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-200 180}
  make_wire 110 70 290 70
  make_wire 110 110 290 110
  make_wire 290 110 290 140
  make_wire -200 30 -200 70
  make_wire -200 70 -90 70
  make_wire -200 70 -300 70
  make_wire -200 140 -200 90
  make_wire -200 90 -90 90
  make_wire -200 90 -310 90
  make_wire -200 -50 -200 -120
  make_wire -200 -120 -420 -120
  make_wire -420 -120 -420 300
  make_wire 240 300 240 130
  make_wire 240 130 110 130
  make_wire -200 220 -200 300
  make_wire -200 300 -420 300
  make_wire -40 370 -40 300
  make_wire -40 300 -200 300
  make_wire -40 300 240 300
}

