proc ICON_full_adder1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -50} -name A
icon_term -type input -origin {-100 -30} -name B
icon_term -type input -origin {-100 -10} -name cin
icon_term -type output -origin {100 -30} -name s2
icon_term -type output -origin {100 30} -name cout
icon_term -type inout -origin {100 70} -name Avdd
icon_term -type inout -origin {100 90} -name Agnd
icon_property -origin {-90 -50} -label A
icon_property -origin {-90 -30} -label B
icon_property -origin {-90 -10} -label cin
icon_property -origin {90 -30} -anchor e -label s2
icon_property -origin {90 30} -anchor e -label cout
icon_property -origin {90 70} -anchor e -label Avdd
icon_property -origin {90 90} -anchor e -label Agnd
icon_property -origin {-90 -100} -label {$name}
icon_property -origin {-90 -80} -label full_adder1
  icon_line -100 -90 100 -90 100 110 -100 110 -100 -90
icon_property -origin {-90 120} -label {example_param=$example_param}
  icon_property -origin {-90 180} -type user -name name -default x
  icon_property -origin {-90 200} -type user -name example_param -default 1.0
}

