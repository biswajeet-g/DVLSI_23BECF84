proc SCHEMATIC_full_adder_test1 {} {
make full_adder1 -name xi0 -origin {1170 100}
make input -name A -origin {930 50}
make input -name B -origin {930 70}
make global -name Gnd -origin {1180 260}
make global -name Vdd -origin {1440 260}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {980 160}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {980 -30}
make output -name s1 -origin {1370 50}
make output -name s2 -origin {1370 70}
make output -name c2 -origin {1370 90}
make output -name c1 -origin {1370 110}
make output -name cout -origin {1370 130}
make pulse -name V2 -pulse_voltage 1.3V -origin {750 160}
  make_wire 1270 50 1370 50
  make_wire 980 50 930 50
  make_wire 980 50 1070 50
  make_wire 870 -100 870 230
  make_wire 980 200 980 230
  make_wire 1300 190 1300 230
  make_wire 980 -100 980 -70
  make_wire 870 230 980 230
  make_wire 870 -100 980 -100
  make_wire 980 10 980 50
  make_wire 1270 70 1370 70
  make_wire 980 230 1180 230
  make_wire 1180 230 1300 230
  make_wire 1300 190 1270 190
  make_wire 1270 170 1440 170
  make_wire 1440 170 1440 260
  make_wire 1270 90 1370 90
  make_wire 1270 110 1370 110
  make_wire 1270 130 1370 130
  make_wire 1070 90 750 90
  make_wire 750 90 750 120
  make_wire 750 200 750 250
  make_wire 750 250 1180 250
  make_wire 1180 250 1180 230
  make_wire 1180 250 1180 260
  make_wire 980 70 980 120
  make_wire 980 70 930 70
  make_wire 980 70 1070 70
}

