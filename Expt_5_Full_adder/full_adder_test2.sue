proc SCHEMATIC_full_adder_test2 {} {
make full_adder1 -name xi0 -origin {160 60}
make input -name A -origin {-80 10}
make input -name B -origin {-80 30}
make global -name Gnd -origin {170 220}
make global -name Vdd -origin {410 160}
make output -name s2 -origin {370 30}
make output -name cout -origin {380 90}
make input -name cin -origin {-200 50}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-30 120}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {-30 -70}
make pulse -name V2 -pulse_voltage 1.3V -origin {-180 120}
  make_wire -30 80 -30 30
  make_wire -30 30 60 30
  make_wire -30 30 -80 30
  make_wire -30 10 -80 10
  make_wire -30 10 60 10
  make_wire -140 -140 -140 190
  make_wire 340 150 340 190
  make_wire -140 -140 -30 -140
  make_wire -30 -30 -30 10
  make_wire -30 190 -140 190
  make_wire 170 190 170 220
  make_wire -30 160 -30 190
  make_wire -30 -140 -30 -110
  make_wire -30 190 170 190
  make_wire 170 190 340 190
  make_wire 340 150 260 150
  make_wire 410 160 410 130
  make_wire 410 130 260 130
  make_wire 260 30 370 30
  make_wire 260 90 380 90
  make_wire -180 80 -180 50
  make_wire -180 50 60 50
  make_wire -180 50 -200 50
  make_wire -180 160 -180 190
  make_wire -180 190 -140 190
}

