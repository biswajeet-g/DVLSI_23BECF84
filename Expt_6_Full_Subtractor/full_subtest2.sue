proc SCHEMATIC_full_subtest2 {} {
make input -name A -origin {-160 60}
make input -name B -origin {-160 80}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-110 170}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {-110 -20}
make pulse -name V2 -pulse_voltage 1.3V -origin {-260 170}
make full_subtractor1 -name xi0 -origin {80 80}
make output -name D -origin {290 60}
make output -name Bout -origin {330 80}
make input -name Bin -origin {-280 100}
make global -name vdd -origin {330 210}
make global -name gnd -origin {90 270}
  make_wire -110 130 -110 80
  make_wire -110 80 -20 80
  make_wire -110 80 -160 80
  make_wire -110 60 -160 60
  make_wire -110 60 -20 60
  make_wire -220 -90 -220 240
  make_wire 260 140 260 240
  make_wire -220 -90 -110 -90
  make_wire -110 20 -110 60
  make_wire -110 240 -220 240
  make_wire 90 240 90 270
  make_wire -110 210 -110 240
  make_wire -110 -90 -110 -60
  make_wire 260 140 180 140
  make_wire 330 120 180 120
  make_wire -260 130 -260 100
  make_wire -260 100 -20 100
  make_wire -260 100 -280 100
  make_wire -260 210 -260 240
  make_wire -260 240 -220 240
  make_wire 180 60 290 60
  make_wire 180 80 330 80
  make_wire 330 120 330 210
  make_wire -110 240 90 240
  make_wire 90 240 260 240
}

