proc SCHEMATIC_full_subtractor1 {} {
make half_subtractor1 -name xi0 -origin {-240 140}
make half_subtractor1 -name xi1 -origin {170 140}
make or_1 -name xi2 -origin {560 130}
make input -name A -origin {-450 120}
make input -name B -origin {-450 140}
make output -name D -origin {330 120}
make input -name Bin -origin {-30 -150}
make output -name Bout -origin {710 120}
make inout -name Avdd -origin {480 310}
make inout -name Agnd -origin {460 430}
  make_wire -340 120 -450 120
  make_wire -340 140 -450 140
  make_wire -140 120 70 120
  make_wire -140 140 -60 140
  make_wire -60 140 -60 10
  make_wire -60 10 410 10
  make_wire 410 120 460 120
  make_wire 270 120 330 120
  make_wire 460 140 270 140
  make_wire 410 10 410 120
  make_wire 70 140 0 140
  make_wire 0 140 0 -150
  make_wire 0 -150 -30 -150
  make_wire 660 120 710 120
  make_wire -140 180 -80 180
  make_wire -80 180 -80 280
  make_wire 690 280 690 160
  make_wire 690 160 660 160
  make_wire 270 180 350 180
  make_wire 350 180 350 280
  make_wire 350 280 -80 280
  make_wire -140 200 -120 200
  make_wire -120 200 -120 400
  make_wire 730 400 730 180
  make_wire 270 200 300 200
  make_wire 300 400 -120 400
  make_wire 480 280 480 310
  make_wire 480 280 350 280
  make_wire 480 280 690 280
  make_wire 660 180 730 180
  make_wire 300 200 300 400
  make_wire 460 400 460 430
  make_wire 460 400 300 400
  make_wire 460 400 730 400
}

proc ICON_full_subtractor1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -20} -name A
icon_term -type input -origin {-100 0} -name B
icon_term -type input -origin {-100 20} -name Bin
icon_term -type output -origin {100 -20} -name D
icon_term -type output -origin {100 0} -name Bout
icon_term -type inout -origin {100 40} -name Avdd
icon_term -type inout -origin {100 60} -name Agnd
icon_property -origin {-90 -20} -label A
icon_property -origin {-90 0} -label B
icon_property -origin {-90 20} -label Bin
icon_property -origin {90 -20} -anchor e -label D
icon_property -origin {90 0} -anchor e -label Bout
icon_property -origin {90 40} -anchor e -label Avdd
icon_property -origin {90 60} -anchor e -label Agnd
icon_property -origin {-90 -70} -label {$name}
icon_property -origin {-90 -50} -label full_subtractor1
  icon_line -100 -60 100 -60 100 80 -100 80 -100 -60
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0
}

