proc SCHEMATIC_half_sub_test1 {} {
make half_subtractor1 -name xi0 -origin {0 90}
make input -name A -origin {-330 70}
make input -name B -origin {-330 90}
make output -name D -origin {260 70}
make output -name Bout -origin {250 90}
make global -name Avdd -origin {310 180}
make global -name Agnd -origin {-60 280}
make pulse -orient RY -name V0 -pulse_voltage 1.3V -origin {-220 -30}
make pulse -name V1 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-220 160}
  make_wire 100 70 260 70
  make_wire 100 90 250 90
  make_wire 100 130 310 130
  make_wire 310 130 310 180
  make_wire -220 10 -220 70
  make_wire -220 70 -100 70
  make_wire -220 70 -330 70
  make_wire -220 120 -220 90
  make_wire -220 90 -100 90
  make_wire -220 90 -330 90
  make_wire -220 -70 -220 -90
  make_wire -220 -90 -430 -90
  make_wire -430 -90 -430 250
  make_wire 150 250 150 150
  make_wire 150 150 100 150
  make_wire -220 200 -220 250
  make_wire -220 250 -430 250
  make_wire -60 250 -60 280
  make_wire -60 250 -220 250
  make_wire -60 250 150 250
}

