proc SCHEMATIC_half_subtest2 {} {
make input -name A -origin {-210 70}
make input -name B -origin {-210 90}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-160 180}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {-160 -10}
make half_subtractor1 -name xi0 -origin {30 90}
make output -name D -origin {230 70}
make output -name Bout -origin {230 90}
make global -name Avdd -origin {300 140}
make global -name Agnd -origin {40 280}
  make_wire 130 70 230 70
  make_wire -160 140 -160 90
  make_wire -160 90 -70 90
  make_wire -160 90 -210 90
  make_wire -160 70 -210 70
  make_wire -160 70 -70 70
  make_wire -270 -80 -270 250
  make_wire 40 250 40 280
  make_wire -160 220 -160 250
  make_wire 170 150 170 250
  make_wire -160 -80 -160 -50
  make_wire -270 250 -160 250
  make_wire -270 -80 -160 -80
  make_wire -160 30 -160 70
  make_wire -160 250 40 250
  make_wire 40 250 170 250
  make_wire 170 150 130 150
  make_wire 300 130 300 140
  make_wire 300 130 130 130
  make_wire 130 90 230 90
}

