proc SCHEMATIC_demux_1_4test {} {
make global -name vdd -origin {1150 250}
make global -name gnd -origin {910 330}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {710 210}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {750 20}
make pulse -name V2 -pulse_voltage 1.3V -origin {560 210}
make demux_1_4 -name xi0 -origin {900 140}
make output -name Y0 -origin {1110 100}
make output -name Y1 -origin {1110 120}
make output -name Y2 -origin {1110 140}
make output -name Y3 -origin {1110 160}
make input -name S0 -origin {660 100}
make input -name S1 -origin {660 120}
make input -name D -origin {540 140}
  make_wire 560 170 560 140
  make_wire 560 140 800 140
  make_wire 560 140 540 140
  make_wire 750 60 750 100
  make_wire 750 100 660 100
  make_wire 750 100 800 100
  make_wire 710 120 800 120
  make_wire 710 120 660 120
  make_wire 1150 200 1150 250
  make_wire 1000 220 1060 220
  make_wire 1060 220 1060 310
  make_wire 460 310 460 -70
  make_wire 460 -70 750 -70
  make_wire 750 -70 750 -20
  make_wire 910 310 1060 310
  make_wire 710 250 710 310
  make_wire 710 310 910 310
  make_wire 560 310 560 250
  make_wire 560 310 460 310
  make_wire 560 310 710 310
  make_wire 1000 140 1110 140
  make_wire 1000 100 1110 100
  make_wire 1000 120 1110 120
  make_wire 1000 160 1110 160
  make_wire 710 120 710 170
  make_wire 910 310 910 330
  make_wire 1000 200 1150 200
}

