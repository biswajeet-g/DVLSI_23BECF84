proc ICON_mux_1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -30} -name S
icon_term -type input -origin {-100 -10} -name I1
icon_term -type input -origin {-100 10} -name I0
icon_term -type output -origin {100 -30} -name Y
icon_term -type inout -origin {100 10} -name vdd
icon_term -type inout -origin {100 30} -name Vdd
icon_term -type inout -origin {100 50} -name Gnd
icon_term -type inout -origin {100 70} -name gnd
icon_property -origin {-90 -30} -label S
icon_property -origin {-90 -10} -label I1
icon_property -origin {-90 10} -label I0
icon_property -origin {90 -30} -anchor e -label Y
icon_property -origin {90 10} -anchor e -label vdd
icon_property -origin {90 30} -anchor e -label Vdd
icon_property -origin {90 50} -anchor e -label Gnd
icon_property -origin {90 70} -anchor e -label gnd
icon_property -origin {-90 -80} -label {$name}
icon_property -origin {-90 -60} -label mux_1
  icon_line -100 -70 100 -70 100 90 -100 90 -100 -70
icon_property -origin {-90 100} -label {example_param=$example_param}
  icon_property -origin {-90 160} -type user -name name -default x
  icon_property -origin {-90 180} -type user -name example_param -default 1.0
}

