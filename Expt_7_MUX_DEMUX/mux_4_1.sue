proc SCHEMATIC_mux_4_1 {} {
make mux_2 -name xi0 -origin {-920 -30}
make mux_2 -name xi1 -origin {-920 150}
make input -name S0 -origin {-1330 -180}
make input -name I0 -origin {-1110 -20}
make input -name I1 -origin {-1110 0}
make input -name I2 -origin {-1100 160}
make input -name I3 -origin {-1100 180}
make input -name S1 -origin {-660 -80}
make mux_2 -name xi2 -origin {-530 70}
make inout -name vdd -origin {-590 220}
make inout -name gnd -origin {-570 310}
  make_wire -1020 -20 -1110 -20
  make_wire -1020 -40 -1330 -40
  make_wire -1330 -40 -1330 -180
  make_wire -1020 140 -1330 140
  make_wire -1330 140 -1330 -40
  make_wire -1020 0 -1110 0
  make_wire -1020 160 -1100 160
  make_wire -1020 180 -1100 180
  make_wire -700 -40 -700 80
  make_wire -820 -40 -700 -40
  make_wire -700 80 -630 80
  make_wire -820 140 -700 140
  make_wire -700 140 -700 100
  make_wire -700 100 -630 100
  make_wire -630 60 -660 60
  make_wire -660 60 -660 -80
  make_wire -430 60 -300 60
  make_wire -390 180 -390 100
  make_wire -390 100 -430 100
  make_wire -820 180 -740 180
  make_wire -740 0 -740 180
  make_wire -740 0 -820 0
  make_wire -820 20 -770 20
  make_wire -340 270 -340 120
  make_wire -820 200 -770 200
  make_wire -590 180 -590 220
  make_wire -590 180 -740 180
  make_wire -590 180 -390 180
  make_wire -430 120 -340 120
  make_wire -770 20 -770 200
  make_wire -770 200 -770 270
  make_wire -570 270 -570 310
  make_wire -570 270 -770 270
  make_wire -570 270 -340 270
}

proc ICON_mux_4_1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -40} -name S0
icon_term -type input -origin {-100 -20} -name I0
icon_term -type input -origin {-100 0} -name I1
icon_term -type input -origin {-100 20} -name I2
icon_term -type input -origin {-100 40} -name I3
icon_term -type input -origin {-100 60} -name S1
icon_term -type inout -origin {100 -20} -name vdd
icon_term -type inout -origin {100 0} -name gnd
icon_property -origin {-90 -40} -label S0
icon_property -origin {-90 -20} -label I0
icon_property -origin {-90 0} -label I1
icon_property -origin {-90 20} -label I2
icon_property -origin {-90 40} -label I3
icon_property -origin {-90 60} -label S1
icon_property -origin {90 -20} -anchor e -label vdd
icon_property -origin {90 0} -anchor e -label gnd
icon_property -origin {-90 -90} -label {$name}
icon_property -origin {-90 -70} -label mux_4_1
  icon_line -100 -80 100 -80 100 80 -100 80 -100 -80
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0
}

