proc SCHEMATIC_mux_4_11 {} {
make input -name S0 -origin {-1120 -220}
make input -name I0 -origin {-900 -60}
make input -name I1 -origin {-900 -40}
make input -name I2 -origin {-890 120}
make input -name I3 -origin {-890 140}
make input -name S1 -origin {-450 -120}
make inout -name vdd -origin {-380 180}
make inout -name gnd -origin {-360 270}
make mux_2 -name xi0 -origin {-710 -70}
make mux_2 -name xi1 -origin {-710 110}
make mux_2 -name xi2 -origin {-320 30}
make output -name Y -origin {-90 20}
  make_wire -810 -60 -900 -60
  make_wire -810 -80 -1120 -80
  make_wire -1120 -80 -1120 -220
  make_wire -810 100 -1120 100
  make_wire -1120 100 -1120 -80
  make_wire -810 -40 -900 -40
  make_wire -810 120 -890 120
  make_wire -810 140 -890 140
  make_wire -490 -80 -490 40
  make_wire -610 -80 -490 -80
  make_wire -490 40 -420 40
  make_wire -610 100 -490 100
  make_wire -490 100 -490 60
  make_wire -490 60 -420 60
  make_wire -420 20 -450 20
  make_wire -450 20 -450 -120
  make_wire -220 20 -90 20
  make_wire -180 140 -180 60
  make_wire -180 60 -220 60
  make_wire -610 140 -530 140
  make_wire -530 -40 -530 140
  make_wire -530 -40 -610 -40
  make_wire -610 -20 -560 -20
  make_wire -130 230 -130 80
  make_wire -610 160 -560 160
  make_wire -380 140 -380 180
  make_wire -380 140 -530 140
  make_wire -380 140 -180 140
  make_wire -220 80 -130 80
  make_wire -560 -20 -560 160
  make_wire -560 160 -560 230
  make_wire -360 230 -360 270
  make_wire -360 230 -560 230
  make_wire -360 230 -130 230
}

proc ICON_mux_4_11 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -40} -name S0
icon_term -type input -origin {-100 -20} -name I0
icon_term -type input -origin {-100 0} -name I1
icon_term -type input -origin {-100 20} -name I2
icon_term -type input -origin {-100 40} -name I3
icon_term -type input -origin {-100 60} -name S1
icon_term -type output -origin {100 -40} -name Y
icon_term -type inout -origin {100 0} -name vdd
icon_term -type inout -origin {100 20} -name gnd
icon_property -origin {-90 -40} -label S0
icon_property -origin {-90 -20} -label I0
icon_property -origin {-90 0} -label I1
icon_property -origin {-90 20} -label I2
icon_property -origin {-90 40} -label I3
icon_property -origin {-90 60} -label S1
icon_property -origin {90 -40} -anchor e -label Y
icon_property -origin {90 0} -anchor e -label vdd
icon_property -origin {90 20} -anchor e -label gnd
icon_property -origin {-90 -90} -label {$name}
icon_property -origin {-90 -70} -label mux_4_11
  icon_line -100 -80 100 -80 100 80 -100 80 -100 -80
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0
}

