proc SCHEMATIC_mux_test1 {} {
make mux_2 -name xi0 -origin {660 70}
make global -name vdd -origin {910 210}
make global -name gnd -origin {670 270}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {470 170}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {510 -20}
make pulse -name V2 -pulse_voltage 1.3V -origin {320 170}
make output -name Y -origin {870 60}
make input -name S -origin {420 60}
make input -name I1 -origin {420 80}
make input -name I0 -origin {300 100}
  make_wire 360 -90 360 240
  make_wire 840 120 840 240
  make_wire 470 240 360 240
  make_wire 320 130 320 100
  make_wire 320 100 560 100
  make_wire 320 100 300 100
  make_wire 320 240 360 240
  make_wire 760 60 870 60
  make_wire 910 100 910 210
  make_wire 910 100 760 100
  make_wire 510 -90 510 -60
  make_wire 470 210 470 240
  make_wire 670 240 670 270
  make_wire 320 210 320 240
  make_wire 470 240 670 240
  make_wire 670 240 840 240
  make_wire 840 120 760 120
  make_wire 470 130 470 60
  make_wire 470 60 560 60
  make_wire 470 60 420 60
  make_wire 360 -90 510 -90
  make_wire 510 20 510 80
  make_wire 510 80 420 80
  make_wire 510 80 560 80
}

