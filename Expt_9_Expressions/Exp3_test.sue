proc SCHEMATIC_Exp3_test {} {
make Expression_3 -name xi0 -origin {110 40}
make global -name vdd -origin {360 160}
make global -name gnd -origin {120 240}
make input -name A -origin {-130 10}
make input -name B -origin {-200 30}
make input -name C -origin {-250 50}
make input -name D -origin {-240 240}
make input -name E -origin {-30 240}
make output -name Y1 -origin {320 10}
make pulse -orient RY -name V0 -pulse_voltage 1.3V -origin {-40 -70}
make pulse -name V1 -pulse_voltage 1.3V -pulse_width 4ns -period 8ns -origin {-140 120}
make pulse -name V2 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-230 120}
make pulse -orient RY -name V3 -pulse_voltage 1.3V -pulse_width 6ns -period 12ns -origin {-80 290}
make pulse -orient RY -name V4 -pulse_voltage 1.3V -pulse_width 7ns -period 14ns -origin {0 290}
  make_wire -230 80 -230 50
  make_wire -230 50 10 50
  make_wire -230 50 -250 50
  make_wire -40 10 -130 10
  make_wire -40 10 10 10
  make_wire 270 70 270 220
  make_wire -330 220 -330 -160
  make_wire -230 220 -330 220
  make_wire 210 10 320 10
  make_wire 360 50 360 160
  make_wire 360 50 210 50
  make_wire 120 220 270 220
  make_wire 270 70 210 70
  make_wire 0 90 10 90
  make_wire -330 350 -330 220
  make_wire 0 330 0 350
  make_wire 120 220 120 240
  make_wire -40 -160 -40 -110
  make_wire -230 160 -230 220
  make_wire -330 -160 -40 -160
  make_wire -40 -30 -40 10
  make_wire -140 160 -140 220
  make_wire -140 30 -140 80
  make_wire -200 30 -140 30
  make_wire 10 30 -140 30
  make_wire -230 220 -140 220
  make_wire 120 220 -140 220
  make_wire -330 350 -80 350
  make_wire 0 350 -80 350
  make_wire -80 70 10 70
  make_wire -80 330 -80 350
  make_wire -80 240 -240 240
  make_wire -80 240 -80 70
  make_wire -80 240 -80 250
  make_wire 0 240 -30 240
  make_wire 0 240 0 90
  make_wire 0 240 0 250
}

