proc ICON_Expression_2 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -30} -name A
icon_term -type input -origin {-100 -10} -name B
icon_term -type input -origin {-100 10} -name C
icon_term -type input -origin {-100 30} -name D
icon_term -type input -origin {-100 50} -name E
icon_term -type output -origin {100 -30} -name Y1
icon_term -type inout -origin {100 10} -name vdd
icon_term -type inout -origin {100 30} -name gnd
icon_term -type inout -origin {100 50} -name Vdd
icon_term -type inout -origin {100 70} -name Gnd
icon_property -origin {-90 -30} -label A
icon_property -origin {-90 -10} -label B
icon_property -origin {-90 10} -label C
icon_property -origin {-90 30} -label D
icon_property -origin {-90 50} -label E
icon_property -origin {90 -30} -anchor e -label Y1
icon_property -origin {90 10} -anchor e -label vdd
icon_property -origin {90 30} -anchor e -label gnd
icon_property -origin {90 50} -anchor e -label Vdd
icon_property -origin {90 70} -anchor e -label Gnd
icon_property -origin {-90 -80} -label {$name}
icon_property -origin {-90 -60} -label Expression_2
  icon_line -100 -70 100 -70 100 90 -100 90 -100 -70
icon_property -origin {-90 100} -label {example_param=$example_param}
  icon_property -origin {-90 160} -type user -name name -default x
  icon_property -origin {-90 180} -type user -name example_param -default 1.0
}

