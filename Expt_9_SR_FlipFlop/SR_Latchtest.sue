proc SCHEMATIC_SR_Latchtest {} {
make global -name vdd -origin {1010 220}
make global -name gnd -origin {770 280}
make input -name S -origin {520 70}
make input -name R -origin {520 90}
make output -name Qn -origin {970 70}
make output -name Qn_1 -origin {970 90}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {570 180}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {610 -10}
make SR_Latch1 -name xi0 -origin {760 90}
  make_wire 460 -80 460 250
  make_wire 860 70 970 70
  make_wire 610 -80 610 -50
  make_wire 570 220 570 250
  make_wire 770 250 770 280
  make_wire 770 250 940 250
  make_wire 460 -80 610 -80
  make_wire 610 30 610 70
  make_wire 610 70 520 70
  make_wire 610 70 660 70
  make_wire 570 140 570 90
  make_wire 570 90 660 90
  make_wire 570 90 520 90
  make_wire 860 90 970 90
  make_wire 460 250 570 250
  make_wire 570 250 770 250
  make_wire 860 150 940 150
  make_wire 940 150 940 250
  make_wire 1010 130 1010 220
  make_wire 1010 130 860 130
}

