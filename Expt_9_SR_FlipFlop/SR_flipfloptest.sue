proc SCHEMATIC_SR_flipfloptest {} {
make SR_flipflop1 -name xi0 -origin {1070 90}
make global -name vdd -origin {1320 220}
make global -name gnd -origin {1080 280}
make input -name S -origin {830 70}
make input -name R -origin {830 90}
make output -name Qn -origin {1280 70}
make output -name Qn_1 -origin {1280 90}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {880 180}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {920 -10}
  make_wire 770 -80 770 250
  make_wire 1170 70 1280 70
  make_wire 920 -80 920 -50
  make_wire 880 220 880 250
  make_wire 1080 250 1080 280
  make_wire 1080 250 1250 250
  make_wire 770 -80 920 -80
  make_wire 920 30 920 70
  make_wire 920 70 830 70
  make_wire 920 70 970 70
  make_wire 880 140 880 90
  make_wire 880 90 970 90
  make_wire 880 90 830 90
  make_wire 1170 90 1280 90
  make_wire 770 250 880 250
  make_wire 880 250 1080 250
  make_wire 1170 150 1250 150
  make_wire 1250 150 1250 250
  make_wire 1320 130 1320 220
  make_wire 1320 130 1170 130
}

