proc SCHEMATIC_SR_flipfloptest2 {} {
make SR_flipflop2 -name xi0 -origin {980 90}
make global -name vdd -origin {1230 220}
make global -name gnd -origin {990 280}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {790 180}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {830 -10}
make pulse -name V2 -pulse_voltage 1.3V -pulse_width 6ns -period 12ns -origin {640 180}
make output -name Qn -origin {1190 70}
make output -name Qn_1 -origin {1190 90}
make input -name S -origin {740 70}
make input -name R -origin {740 90}
make input -name clk -origin {620 110}
  make_wire 680 -80 680 250
  make_wire 1160 150 1160 250
  make_wire 790 250 680 250
  make_wire 640 140 640 110
  make_wire 640 110 880 110
  make_wire 640 110 620 110
  make_wire 640 250 680 250
  make_wire 1080 70 1190 70
  make_wire 830 -80 830 -50
  make_wire 790 220 790 250
  make_wire 990 250 990 280
  make_wire 640 220 640 250
  make_wire 680 -80 830 -80
  make_wire 830 30 830 70
  make_wire 830 70 740 70
  make_wire 830 70 880 70
  make_wire 790 140 790 90
  make_wire 790 90 880 90
  make_wire 790 90 740 90
  make_wire 1080 90 1190 90
  make_wire 790 250 990 250
  make_wire 990 250 1160 250
  make_wire 1160 150 1080 150
  make_wire 1080 130 1230 130
  make_wire 1230 130 1230 220
}

