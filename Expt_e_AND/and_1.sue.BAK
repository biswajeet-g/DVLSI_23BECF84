proc SCHEMATIC_and_1 {} {
make input -name A -origin {340 230}
make input -orient RXY -name B -origin {800 230}
make inout -name Gnd -origin {580 730}
make pmos4 -name M0 -origin {520 230}
make nmos4 -name M1 -origin {580 480}
make nmos4 -name M2 -origin {580 660}
make pmos4 -orient RX -name M3 -origin {640 230}
make output -name Vout -origin {1240 440}
make inout -name Gnd -origin {1140 670}
make pmos4 -name M4 -origin {1140 320}
make nmos4 -name M5 -origin {1140 570}
  make_wire 520 270 520 370
  make_wire 640 370 640 270
  make_wire 520 190 520 130
  make_wire 640 130 640 190
  make_wire 580 130 580 70
  make_wire 520 480 400 480
  make_wire 400 480 400 230
  make_wire 400 230 340 230
  make_wire 400 230 460 230
  make_wire 580 520 580 620
  make_wire 520 660 410 660
  make_wire 410 660 410 780
  make_wire 410 780 740 780
  make_wire 740 230 700 230
  make_wire 740 230 800 230
  make_wire 580 230 520 230
  make_wire 580 230 640 230
  make_wire 650 710 580 710
  make_wire 580 710 580 700
  make_wire 580 710 580 730
  make_wire 580 660 650 660
  make_wire 650 660 650 710
  make_wire 580 130 580 230
  make_wire 520 130 580 130
  make_wire 580 130 640 130
  make_wire 520 370 580 370
  make_wire 580 370 640 370
  make_wire 1080 320 970 320
  make_wire 970 570 1080 570
  make_wire 970 450 890 450
  make_wire 1140 440 1240 440
  make_wire 1140 640 1200 640
  make_wire 1200 640 1200 570
  make_wire 1200 570 1140 570
  make_wire 1140 640 1140 610
  make_wire 1140 640 1140 670
  make_wire 1140 360 1140 440
  make_wire 1140 440 1140 530
  make_wire 970 320 970 450
  make_wire 1140 220 1210 220
  make_wire 1210 220 1210 320
  make_wire 1210 320 1140 320
  make_wire 1140 220 1140 280
  make_wire 970 570 970 450
  make_wire 580 480 650 480
  make_wire 650 480 650 660
  make_wire 740 780 740 230
  make_wire 580 410 580 370
  make_wire 580 410 580 440
  make_wire 890 410 890 450
  make_wire 890 410 580 410
  make_wire 580 70 1140 70
  make_wire 1140 70 1140 220
}

proc ICON_and_1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -10} -name A
icon_term -type input -origin {-100 10} -name B
icon_term -type output -origin {100 -10} -name Vout
icon_term -type inout -origin {100 30} -name Gnd
icon_term -type inout -origin {100 50} -name Gnd
icon_property -origin {-90 -10} -label A
icon_property -origin {-90 10} -label B
icon_property -origin {90 -10} -anchor e -label Vout
icon_property -origin {90 30} -anchor e -label Gnd
icon_property -origin {90 50} -anchor e -label Gnd
icon_property -origin {-90 -60} -label {$name}
icon_property -origin {-90 -40} -label and_1
  icon_line -100 -50 100 -50 100 70 -100 70 -100 -50
icon_property -origin {-90 80} -label {example_param=$example_param}
  icon_property -origin {-90 140} -type user -name name -default x
  icon_property -origin {-90 160} -type user -name example_param -default 1.0
}

