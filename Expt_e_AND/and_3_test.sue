proc SCHEMATIC_and_3_test {} {
make output -name Vout -origin {320 50}
make global -name vdd -origin {320 90}
make input -name A -origin {-240 50}
make input -name B -origin {-240 70}
make global -name gnd -origin {40 340}
make and_2 -name xi0 -origin {30 60}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-160 160}
make pulse -orient RY -name V1 -pulse_voltage 1.3V -origin {-160 -30}
  make_wire 130 50 320 50
  make_wire 130 90 320 90
  make_wire 130 110 280 110
  make_wire -160 10 -160 50
  make_wire -160 50 -70 50
  make_wire -160 50 -240 50
  make_wire -160 120 -160 70
  make_wire -160 70 -70 70
  make_wire -160 70 -240 70
  make_wire 280 110 280 290
  make_wire -350 290 -350 -130
  make_wire -350 -130 -160 -130
  make_wire -160 -130 -160 -70
  make_wire -160 200 -160 290
  make_wire -160 290 -350 290
  make_wire 40 290 40 340
  make_wire 40 290 -160 290
  make_wire 40 290 280 290
}

