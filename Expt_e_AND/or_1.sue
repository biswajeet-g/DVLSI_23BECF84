proc SCHEMATIC_or_1 {} {
make pmos4 -name M0 -origin {520 140}
make pmos4 -name M1 -origin {520 250}
make nmos4 -name M2 -origin {430 400}
make nmos4 -orient RX -name M3 -origin {630 400}
make nmos4 -name M4 -origin {830 340}
make pmos4 -name M5 -origin {830 200}
make inout -name avdd -origin {520 40}
make inout -name agnd -origin {520 500}
make input -name A -origin {250 140}
make input -name B -origin {250 250}
make output -name vout -origin {960 270}
  make_wire 520 210 520 180
  make_wire 520 330 430 330
  make_wire 430 330 430 360
  make_wire 520 330 630 330
  make_wire 630 330 630 360
  make_wire 430 440 430 460
  make_wire 630 460 630 440
  make_wire 520 460 630 460
  make_wire 520 460 430 460
  make_wire 770 200 740 200
  make_wire 740 340 770 340
  make_wire 520 300 740 300
  make_wire 520 300 520 330
  make_wire 520 300 520 290
  make_wire 740 300 740 200
  make_wire 740 300 740 340
  make_wire 830 160 830 70
  make_wire 520 70 520 100
  make_wire 520 70 520 40
  make_wire 520 140 560 140
  make_wire 560 140 560 70
  make_wire 560 70 830 70
  make_wire 560 70 520 70
  make_wire 830 200 870 200
  make_wire 870 200 870 70
  make_wire 870 70 830 70
  make_wire 830 380 830 480
  make_wire 830 480 520 480
  make_wire 520 480 520 460
  make_wire 520 480 520 500
  make_wire 520 400 520 460
  make_wire 520 400 430 400
  make_wire 520 400 630 400
  make_wire 830 340 860 340
  make_wire 860 340 860 480
  make_wire 860 480 830 480
  make_wire 520 250 560 250
  make_wire 560 250 560 140
  make_wire 830 270 960 270
  make_wire 830 270 830 240
  make_wire 830 270 830 300
  make_wire 370 400 330 400
  make_wire 330 400 330 140
  make_wire 330 140 460 140
  make_wire 330 140 250 140
  make_wire 690 400 720 400
  make_wire 720 400 720 560
  make_wire 720 560 290 560
  make_wire 290 560 290 250
  make_wire 290 250 460 250
  make_wire 290 250 250 250
}

proc ICON_or_1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -10} -name A
icon_term -type input -origin {-100 10} -name B
icon_term -type output -origin {100 -10} -name vout
icon_term -type inout -origin {100 30} -name avdd
icon_term -type inout -origin {100 50} -name agnd
icon_property -origin {-90 -10} -label A
icon_property -origin {-90 10} -label B
icon_property -origin {90 -10} -anchor e -label vout
icon_property -origin {90 30} -anchor e -label avdd
icon_property -origin {90 50} -anchor e -label agnd
icon_property -origin {-90 -60} -label {$name}
icon_property -origin {-90 -40} -label or_1
  icon_line -100 -50 100 -50 100 70 -100 70 -100 -50
icon_property -origin {-90 80} -label {example_param=$example_param}
  icon_property -origin {-90 140} -type user -name name -default x
  icon_property -origin {-90 160} -type user -name example_param -default 1.0
}

