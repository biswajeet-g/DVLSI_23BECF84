proc SCHEMATIC_xor_1test {} {
make xor_1 -name xi0 -origin {1250 60}
make input -name A -origin {940 50}
make input -name B -origin {930 70}
make output -name vout -origin {1530 50}
make global -name Avdd -origin {1530 120}
make global -name Agnd -origin {1200 350}
make pulse -orient RY -name V0 -pulse_voltage 1.3V -origin {1040 -30}
make pulse -name V1 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {1040 160}
  make_wire 1350 50 1530 50
  make_wire 1350 90 1530 90
  make_wire 1530 90 1530 120
  make_wire 1040 10 1040 50
  make_wire 1040 50 1150 50
  make_wire 1040 50 940 50
  make_wire 1040 120 1040 70
  make_wire 1040 70 1150 70
  make_wire 1040 70 930 70
  make_wire 1040 -70 1040 -140
  make_wire 1040 -140 820 -140
  make_wire 820 -140 820 280
  make_wire 1480 280 1480 110
  make_wire 1480 110 1350 110
  make_wire 1040 200 1040 280
  make_wire 1040 280 820 280
  make_wire 1200 350 1200 280
  make_wire 1200 280 1040 280
  make_wire 1200 280 1480 280
}

