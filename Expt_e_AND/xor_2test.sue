proc SCHEMATIC_xor_2test {} {
make input -name A -origin {950 50}
make input -name B -origin {940 70}
make output -name vout -origin {1540 50}
make global -name Avdd -origin {1540 120}
make global -name Agnd -origin {1210 350}
make xor_1 -name xi0 -origin {1260 60}
make pulse -orient RY -name V0 -pulse_voltage 1.3V -origin {1050 -30}
make pulse -name V1 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {1050 160}
  make_wire 1360 50 1540 50
  make_wire 1360 90 1540 90
  make_wire 1540 90 1540 120
  make_wire 1050 10 1050 50
  make_wire 1050 50 1160 50
  make_wire 1050 50 950 50
  make_wire 1050 120 1050 70
  make_wire 1050 70 1160 70
  make_wire 1050 70 940 70
  make_wire 1050 -70 1050 -140
  make_wire 1050 -140 830 -140
  make_wire 830 -140 830 280
  make_wire 1490 280 1490 110
  make_wire 1490 110 1360 110
  make_wire 1050 200 1050 280
  make_wire 1050 280 830 280
  make_wire 1210 350 1210 280
  make_wire 1210 280 1050 280
  make_wire 1210 280 1490 280
}

