proc SCHEMATIC_inv_1 {} {
make pmos4 -name M0 -origin {1370 200}
make nmos4 -name M1 -origin {1370 450}
make output -name Vout -origin {1470 320}
make input -name Vin -origin {1120 330}
make inout -name Vdd -origin {1370 50}
make inout -name Gnd -origin {1370 550}
  make_wire 1310 200 1200 200
  make_wire 1200 450 1310 450
  make_wire 1200 330 1120 330
  make_wire 1370 320 1470 320
  make_wire 1370 520 1430 520
  make_wire 1430 520 1430 450
  make_wire 1430 450 1370 450
  make_wire 1370 520 1370 490
  make_wire 1370 520 1370 550
  make_wire 1370 240 1370 320
  make_wire 1370 320 1370 410
  make_wire 1200 200 1200 330
  make_wire 1200 330 1200 450
  make_wire 1370 100 1440 100
  make_wire 1440 100 1440 200
  make_wire 1440 200 1370 200
  make_wire 1370 50 1370 100
  make_wire 1370 100 1370 160
}

proc ICON_inv_1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -10} -name Vin
icon_term -type output -origin {100 -10} -name Vout
icon_term -type inout -origin {100 30} -name Vdd
icon_term -type inout -origin {100 50} -name Gnd
icon_property -origin {-90 -10} -label Vin
icon_property -origin {90 -10} -anchor e -label Vout
icon_property -origin {90 30} -anchor e -label Vdd
icon_property -origin {90 50} -anchor e -label Gnd
icon_property -origin {-90 -60} -label {$name}
icon_property -origin {-90 -40} -label inv_1
  icon_line -100 -50 100 -50 100 70 -100 70 -100 -50
icon_property -origin {-90 80} -label {example_param=$example_param}
  icon_property -origin {-90 140} -type user -name name -default x
  icon_property -origin {-90 160} -type user -name example_param -default 1.0
}

